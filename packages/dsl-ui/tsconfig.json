{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "dist",
		"tsBuildInfoFile": "dist/.tsbuildinfo",
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM"],
		"types": ["@testing-library/jest-dom"],
		"paths": {
			"@dsl-ui/*": ["./src/*"],
			"@dsl-renderer/*": ["../dsl-renderer/src/*"]
		}
	},
	"references": [
		{ "path": "../dsl-renderer" }
	],
	"include": ["src/**/*"],
	"exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.stories.tsx"]
}
